import asyncio
import functools
import inspect
import logging
import random
import time
from collections.abc import Callable
from typing import Any, cast

logger = logging.getLogger(__name__)


def retry[F: Callable[..., Any]](
    attempts: int = 3,
    *,
    exceptions: type[BaseException] | tuple[type[BaseException], ...] = Exception,
    delay: float = 0.5,
    backoff: float = 2.0,
    max_delay: float = 30.0,
    jitter: bool = True,
) -> Callable[[F], F]:
    """Retry the decorated function (sync or async) when it raises `exceptions`.

    Waits delay, delay * backoff, ... (at most max_delay) between tries; with jitter a
    random part of that, so many clients don't retry in lockstep. After `attempts`
    tries the last error is raised.

        @retry(attempts=5, exceptions=(ConnectionError, TimeoutError))
        async def fetch_rates() -> dict: ...
    """
    if attempts < 1:
        raise ValueError("attempts must be at least 1")

    def wait_time(attempt: int) -> float:
        wait = min(delay * backoff ** (attempt - 1), max_delay)
        return random.uniform(0, wait) if jitter else wait

    def decorate(func: F) -> F:
        def log(error: BaseException, attempt: int, wait: float) -> None:
            logger.warning(
                "%s failed (%r), retry %d/%d in %.2fs",
                func.__qualname__,
                error,
                attempt,
                attempts - 1,
                wait,
            )

        if inspect.iscoroutinefunction(func):

            @functools.wraps(func)
            async def async_wrapper(*args: Any, **kwargs: Any) -> Any:
                for attempt in range(1, attempts):
                    try:
                        return await func(*args, **kwargs)
                    except exceptions as error:
                        log(error, attempt, wait := wait_time(attempt))
                        await asyncio.sleep(wait)
                return await func(*args, **kwargs)  # last try: errors propagate

            return cast(F, async_wrapper)

        @functools.wraps(func)
        def wrapper(*args: Any, **kwargs: Any) -> Any:
            for attempt in range(1, attempts):
                try:
                    return func(*args, **kwargs)
                except exceptions as error:
                    log(error, attempt, wait := wait_time(attempt))
                    time.sleep(wait)
            return func(*args, **kwargs)  # last try: errors propagate

        return cast(F, wrapper)

    return decorate
