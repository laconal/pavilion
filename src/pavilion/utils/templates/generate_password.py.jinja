import secrets
import string


def generate_password(length: int = 12) -> str:
    """A random password of `length` characters: letters, digits and symbols.

    Uses `secrets`, so it's suitable for credentials (unlike `random`).
    """
    alphabet = (
        string.ascii_letters +
        string.digits +
        "!@#$%^&*-_=+?"
    )

    return "".join(secrets.choice(alphabet) for _ in range(length))
