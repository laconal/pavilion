def mask_secret(secret: str, visible: int = 4) -> str:
    """Show only the last `visible` characters: "sk_live_51Hx...f3a9" -> "****f3a9".

    Always four stars, so the secret's length doesn't leak; secrets shorter than
    twice `visible` are hidden completely.
    """
    if len(secret) < visible * 2:
        return "****"
    return "****" + secret[-visible:]
