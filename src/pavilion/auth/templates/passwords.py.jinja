"""Password hashing with {{ "Argon2" if hashing == "argon2" else "bcrypt" }}."""

{% if hashing == "argon2" %}
from argon2 import PasswordHasher
from argon2.exceptions import InvalidHashError, VerificationError

# Defaults to RFC 9106's recommended (low-memory) parameters.
_hasher = PasswordHasher()


def hash_password(password: str) -> str:
    return _hasher.hash(password)


def verify_password(password: str, password_hash: str) -> bool:
    try:
        return _hasher.verify(password_hash, password)
    except (VerificationError, InvalidHashError):
        return False
{% else %}
import bcrypt


def hash_password(password: str) -> str:
    # bcrypt rejects passwords over 72 bytes (ValueError); cap length at signup.
    return bcrypt.hashpw(password.encode(), bcrypt.gensalt()).decode()


def verify_password(password: str, password_hash: str) -> bool:
    try:
        return bcrypt.checkpw(password.encode(), password_hash.encode())
    except ValueError:  # malformed hash or over-long password
        return False
{% endif %}
